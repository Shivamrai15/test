generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  name      String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  employeeId      String         @unique
  name            String
  email           String         @unique
  baseSalary      Int
  variablePay     Int
  dob             DateTime
  joiningDate     DateTime
  paymentEvents   PaymentEvent[]
  address         Address?
  anniversaryDate DateTime?
  isActive        Boolean        @default(true)
  spouse          Spouse?
  kids            Kid[]

  createdBy String
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Spouse {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  dob        DateTime
  employeeId String @db.ObjectId @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdBy String
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Kid {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  dob        DateTime
  employeeId String @db.ObjectId
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdBy String
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


enum PAYMENTTYPE {
  SALARY
  INSURANCE
  ANNIVERSARY
  BIRTHDAY
  DIWALI
}

model PaymentEvent {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  occasion         String
  paymentType      PAYMENTTYPE
  reminderDate     DateTime
  eventDate        DateTime
  paymentDate      DateTime?
  paymentConfirmed DateTime?
  amount           Int
  employeeId       String      @db.ObjectId
  employee         Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  isActive         Boolean     @default(true)

  createdBy String
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Address {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  streetAddress String
  city          String
  state         String
  country       String
  pincode       String
  isActive      Boolean  @default(true)
  employeeId    String   @unique @db.ObjectId
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdBy String
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}